        "name": "DirectiveId",
        "workOrderType": "WorkOrderType",
        "workType": "WorkType",
        "site": "InventorySiteId",
        "warehouse": "WarehouseId",
        "sequence": "SequenceNumber",
        "directiveCode": "WarehouseLocationDirectiveCode",
