        "WarehouseLocationTypeId",
        "UseLicensePlateTracking"
      ],
      "fields": {
        "id": "ProfileId",
        "locationType": "WarehouseLocationTypeId",
        "lpControlled": "UseLicensePlateTracking"
      }
    },
    "workClasses": {
      "label": "Work classes",
      "cdmEntity": "WHSWarehouseWorkClassEntity",
      "entitySet": "",
      "legalEntityField": "dataAreaId",
      "warehouseField": "",
