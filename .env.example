# Copy to .env (git-ignored). process.env wins over this file.
PORT=5176

# Option 1: one JSON value (same shape as the DM Quality Tool's DM_QUALITY_D365_CONNECTION, which is also accepted).
# STROOM_D365_CONNECTION={"environmentUrl":"https://customer-acc.sandbox.operations.dynamics.com","tenantId":"...","clientId":"...","clientSecret":"...","label":"ACC"}

# Option 2: separate keys.
STROOM_D365_ENVIRONMENT_URL=
STROOM_D365_TENANT_ID=
STROOM_D365_CLIENT_ID=
STROOM_D365_CLIENT_SECRET=
# DEV, TEST, ACC or PROD — shown in the header.
STROOM_D365_ENV_LABEL=ACC
