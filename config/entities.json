{
  "_comment": "Mapping D365 OData entity -> internal model. Field names come from the Microsoft Common Data Model schema of the standard data entities (github.com/microsoft/CDM, operationsCommon/Entities/SupplyChain/WMS). The OData entity set (public collection) name differs per version: leave entitySet empty and use 'Automatisch herkennen' on the Koppeling tab, which finds the entity set in $metadata whose fields contain all 'match' fields. 'A+B' joins fields with '|' (composite keys). The customer version is saved to data/entities.json (not in git).",
  "sources": {
    "locations": {
      "label": "Locaties",
      "cdmEntity": "WMSWarehouseLocationEntity",
      "entitySet": "",
      "legalEntityField": "dataAreaId",
      "warehouseField": "WarehouseId",
      "match": [
        "WarehouseLocationId",
        "WarehouseZoneId",
        "WarehouseLocationProfileId",
        "WarehouseAisleId",
        "IsDefaultReceiptWarehouseLocation"
      ],
      "fields": {
        "id": "WarehouseLocationId",
        "warehouse": "WarehouseId",
        "zoneId": "WarehouseZoneId",
        "profileId": "WarehouseLocationProfileId",
        "aisleId": "WarehouseAisleId",
        "rack": "RackId",
        "level": "ShelfId",
        "position": "BinId",
        "isDefaultReceipt": "IsDefaultReceiptWarehouseLocation",
        "isDefaultIssue": "IsDefaultIssueWarehouseLocation",
        "isDefaultProductionInput": "IsDefaultProductionInputWarehouseLocation",
        "isDefaultProductionOutput": "IsDefaultProductionFinishedGoodsWarehouseLocation"
      }
    },
    "zones": {
